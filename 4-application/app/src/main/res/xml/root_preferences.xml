<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--Here's how to be able to simulate the diff env to show full func-->
    <PreferenceCategory app:title="Environment">


        <SwitchPreferenceCompat
            app:key="env"
            app:title="Enable Environment" />

        <ListPreference
            android:key="simulated_location"
            android:title="Location"
            android:summary="Choose your location for environmental conditions"
            android:defaultValue="cardiff"
            android:entries="@array/simulated_location_entries"
            android:entryValues="@array/simulated_location_values"/>

        <ListPreference
            android:key="simulated_condition"
            android:title="Weather Condition"
            android:summary="Select your weather condition"
            android:defaultValue="hot_dry"
            android:entries="@array/simulated_condition_entries"
            android:entryValues="@array/simulated_condition_values"/>


    </PreferenceCategory>

    <PreferenceCategory app:title="Notifications">

    </PreferenceCategory>

</PreferenceScreen>
