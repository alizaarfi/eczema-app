<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="360dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/black" />

    <EditText
        android:id="@+id/editTextDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="date"
        android:contentDescription="Input field for date"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/daySelectorGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnClose">

        <ToggleButton
            android:id="@+id/btnMonday"
            style="@style/DayToggleStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/monday"
            android:textOff="@string/m"
            android:textOn="@string/m" />

        <ToggleButton
            android:id="@+id/btnTuesday"
            style="@style/DayToggleStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/tuesday"
            android:textOff="@string/t"
            android:textOn="@string/t" />

        <ToggleButton
            android:id="@+id/btnWednesday"
            style="@style/DayToggleStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/wednesday"
            android:textOff="@string/w"
            android:textOn="@string/w" />

        <ToggleButton
            android:id="@+id/btnThursday"
            style="@style/DayToggleStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/thursday"
            android:textOff="@string/t"
            android:textOn="@string/t" />

        <ToggleButton
            android:id="@+id/btnFriday"
            style="@style/DayToggleStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/friday"
            android:textOff="@string/f"
            android:textOn="@string/f" />

        <ToggleButton
            android:id="@+id/btnSaturday"
            style="@style/DayToggleStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/saturday"
            android:textOff="@string/s"
            android:textOn="@string/s" />

        <ToggleButton
            android:id="@+id/btnSunday"
            style="@style/DayToggleStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/sunday"
            android:textOff="@string/s"
            android:textOn="@string/s" />
    </LinearLayout>

    <TextView
        android:id="@+id/logQuestion1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="@string/physical_sensations"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/daySelectorGroup" />

    <TextView
        android:id="@+id/logQuestion2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="@string/mood"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logQuestion1" />

    <TextView
        android:id="@+id/logQuestion3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="@string/body_areas"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logQuestion2" />

    <TextView
        android:id="@+id/logQuestion4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="@string/treatment"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logQuestion3" />

    <TextView
        android:id="@+id/logQuestion5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="@string/environment"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logQuestion4" />

    <TextView
        android:id="@+id/logQuestion6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="@string/diet_hydration"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logQuestion5" />

    <TextView
        android:id="@+id/logQuestion7"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="@string/other"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logQuestion6" />


</androidx.constraintlayout.widget.ConstraintLayout>