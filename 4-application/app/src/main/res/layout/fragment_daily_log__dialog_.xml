<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DailyLog_Dialog_Fragment">

    <!-- Header Section -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/black" />

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/daily_log"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnClose" />

    <!-- Date Navigation with Arrows -->
    <LinearLayout
        android:id="@+id/dateNavigationLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnPreviousWeek"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous_week"
            android:src="@drawable/left_arrow_icon"
            app:tint="@color/black" />

        <EditText
            android:id="@+id/editTextDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textSize="20sp"
            android:textAlignment="center"
            android:contentDescription="Input field for date"
            android:ems="10"
            android:importantForAccessibility="no"
            android:inputType="date" />

        <ImageButton
            android:id="@+id/btnNextWeek"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_week"
            android:src="@drawable/right_arrow_icon"
            app:tint="@color/black" />
    </LinearLayout>

    <!-- Day Selector Group -->
    <LinearLayout
        android:id="@+id/weekNavigationLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/dateNavigationLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/daySelectorGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="5dp">

            <ToggleButton
                android:id="@+id/btnMonday"
                style="@style/DayToggleStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/monday"
                android:textOff="@string/m"
                android:textOn="@string/m" />

            <ToggleButton
                android:id="@+id/btnTuesday"
                style="@style/DayToggleStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/tuesday"
                android:textOff="@string/t"
                android:textOn="@string/t" />

            <ToggleButton
                android:id="@+id/btnWednesday"
                style="@style/DayToggleStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/wednesday"
                android:textOff="@string/w"
                android:textOn="@string/w" />

            <ToggleButton
                android:id="@+id/btnThursday"
                style="@style/DayToggleStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/thursday"
                android:textOff="@string/t"
                android:textOn="@string/t" />

            <ToggleButton
                android:id="@+id/btnFriday"
                style="@style/DayToggleStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/friday"
                android:textOff="@string/f"
                android:textOn="@string/f" />

            <ToggleButton
                android:id="@+id/btnSaturday"
                style="@style/DayToggleStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/saturday"
                android:textOff="@string/s"
                android:textOn="@string/s" />

            <ToggleButton
                android:id="@+id/btnSunday"
                style="@style/DayToggleStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/sunday"
                android:textOff="@string/s"
                android:textOn="@string/s" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main ScrollView Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/weekNavigationLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <!-- Physical Sensations Section -->
            <TextView
                android:id="@+id/logQuestion1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/physical_sensations"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <HorizontalScrollView
                android:id="@+id/emojiScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/logQuestion1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Mood Section -->
            <TextView
                android:id="@+id/logQuestion2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/mood"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/emojiScrollView" />

            <HorizontalScrollView
                android:id="@+id/moodEmojiScrollView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/logQuestion2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Body Areas Section -->
            <TextView
                android:id="@+id/logQuestion3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/body_areas"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/moodEmojiScrollView" />

            <HorizontalScrollView
                android:id="@+id/bodyAreasScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/logQuestion3">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/bodyAreasChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:singleSelection="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFace"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_face"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipChest"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_chest"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBack"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_back"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTorso"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_torso"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipArmHand"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_arm_hand"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLegFeet"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_leg_feet"/>
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Intensity Slider (initially hidden) -->
            <LinearLayout
                android:id="@+id/bodyAreaIntensityLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/bodyAreasScrollView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/bodyAreaIntensityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/intensity_label"
                    android:textSize="16sp"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/bodyAreaIntensitySlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:valueFrom="0"
                    android:valueTo="2"
                    android:stepSize="1"
                    android:value="1"
                    app:tickVisible="true"
                    app:tickColorActive="@color/design_default_color_primary"
                    app:tickColorInactive="@color/design_default_color_primary_dark"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/intensity_mild"
                        android:gravity="start"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/intensity_moderate"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/intensity_severe"
                        android:gravity="end"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Treatment Section -->
            <TextView
                android:id="@+id/logQuestion4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/treatment"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bodyAreaIntensityLayout" />

            <HorizontalScrollView
                android:id="@+id/treatmentEmojiScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/logQuestion4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Environment Section -->
            <TextView
                android:id="@+id/logQuestion5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/environment"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/treatmentEmojiScrollView" />

            <HorizontalScrollView
                android:id="@+id/environmentScrollView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/logQuestion5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Diet and Hydration Section -->
            <TextView
                android:id="@+id/logQuestion6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/diet_hydration"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/environmentScrollView" />

            <HorizontalScrollView
                android:id="@+id/dietHydrationScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/logQuestion6"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Exercise and Sleep Section -->
            <TextView
                android:id="@+id/logQuestion7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/exercise_sleep"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dietHydrationScrollView" />

            <HorizontalScrollView
                android:id="@+id/exerciseSleepScrollView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/logQuestion7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Save Button -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/saveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:text="@string/save"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>