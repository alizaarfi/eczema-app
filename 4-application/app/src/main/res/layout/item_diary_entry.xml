<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/diaryEntryCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvEntryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            tools:text="April 8, 2025"/>

        <TextView
            android:id="@+id/textFoodProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/food_product_name"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/textReactionSeverity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reaction &amp; Severity"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/buttonEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>